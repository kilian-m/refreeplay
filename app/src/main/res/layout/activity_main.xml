<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Replay / review video (only visible on the replay screen) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- Live camera preview (moved off-screen when not shown; the camera keeps running) -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <io.github.kilianm.refreeplay.AspectSurfaceView
            android:id="@+id/previewView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Delayed view (delay mode) -->
    <TextureView
        android:id="@+id/delayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top bar: settings, mode switch, status -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="Settings"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⚙"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeReplay"
                    style="@style/ModeButton"
                    android:text="Replay" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeDelay"
                    style="@style/ModeButton"
                    android:text="Delay" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="#99000000"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Live / delay screen actions -->
    <LinearLayout
        android:id="@+id/liveActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBig"
            style="@style/LiveReplayButton"
            android:text="REPLAY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickSave"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="168dp"
            android:layout_height="56dp"
            android:layout_margin="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Quick save"
            android:textSize="16sp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart" />
    </LinearLayout>

    <TextView
        android:id="@+id/delayBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="#1565C0"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/replayBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="#D32F2F"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Replay screen: timeline + transport controls -->
    <LinearLayout
        android:id="@+id/replayControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:progressTint="#E53935"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/frameText"
                android:layout_width="wrap_content"
                android:minWidth="120dp"
                android:maxLines="1"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#BBBBBB"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Horizontal in landscape (one row), vertical in portrait (two rows). -->
        <LinearLayout
            android:id="@+id/buttonRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/groupTransport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack1"
                    style="@style/ReplayButton"
                    android:text="−1 s" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevFrame"
                    style="@style/ReplayButton"
                    android:text="◀︎|" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    style="@style/ReplayButton"
                    android:text="▶︎" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextFrame"
                    style="@style/ReplayButton"
                    android:text="|▶︎" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFwd1"
                    style="@style/ReplayButton"
                    android:text="+1 s" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupExtras"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeed"
                    style="@style/ReplayButton"
                    android:text="1×" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCut"
                    style="@style/ReplayButton"
                    android:contentDescription="Cut and save"
                    android:text=""
                    app:icon="@drawable/ic_cut"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickSaveClip"
                    style="@style/ReplayButton"
                    android:contentDescription="Quick save"
                    android:text=""
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLive"
                    style="@style/ReplayButton"
                    android:text="LIVE"
                    android:textColor="#FF8A80" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cut panel: choose the part of the clip to keep, then save it -->
    <LinearLayout
        android:id="@+id/trimPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D9000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/trimLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/trimSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1"
            app:labelBehavior="gone"
            app:values="@array/trim_initial" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag the two handles; the video shows the frame at the handle. The start snaps to the nearest earlier key frame (at most 0.5 s)."
            android:textColor="#BBBBBB"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrimCancel"
                style="@style/ReplayButton"
                android:text="Cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrimSaveAs"
                style="@style/ReplayButton"
                android:text="Save as…" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrimQuick"
                style="@style/ReplayButton"
                android:text="Quick save" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD000000"
        android:gravity="center"
        android:maxWidth="520dp"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
